{
  "openapi": "3.0.0",
  "info": {
    "title": "Cooking Recipe API",
    "description": "API documentation for the Simple Cooking Recipe web application.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api",
      "description": "API Base URL"
    }
  ],
  "paths": {
    "/cuisines": {
      "get": {
        "summary": "Get all cuisines",
        "tags": ["Cuisines"],
        "responses": {
          "200": {
            "description": "List of cuisines",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Cuisine"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/cuisines/{id}/recipes": {
      "get": {
        "summary": "Get recipes by cuisine ID",
        "tags": ["Cuisines", "Recipes"],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Cuisine ID"
          }
        ],
        "responses": {
          "200": {
            "description": "List of recipes for the given cuisine",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Recipe"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ingredients": {
      "get": {
        "summary": "Get all ingredients",
        "tags": ["Ingredients"],
        "responses": {
          "200": {
            "description": "List of ingredients",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Ingredient"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/recipes": {
      "get": {
        "summary": "Get all recipes with optional filtering",
        "tags": ["Recipes"],
        "parameters": [
          {
            "in": "query",
            "name": "search",
            "schema": {
              "type": "string"
            },
            "description": "Search keyword for recipe title"
          },
          {
            "in": "query",
            "name": "cuisineId",
            "schema": {
              "type": "integer"
            },
            "description": "Filter by cuisine ID"
          },
          {
            "in": "query",
            "name": "ingredients",
            "schema": {
              "type": "string"
            },
            "description": "Filter by ingredient names (comma-separated)"
          }
        ],
        "responses": {
          "200": {
            "description": "List of recipes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Recipe"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new recipe",
        "tags": ["Recipes"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "cuisineId": { "type": "integer" },
                  "imageId": { "type": "integer", "nullable": true },
                  "ingredients": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "instructions": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                },
                "required": ["title", "cuisineId", "ingredients", "instructions"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Recipe created successfully"
          }
        }
      }
    },
    "/recipes/{id}": {
      "get": {
        "summary": "Get recipe details by ID",
        "tags": ["Recipes"],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Recipe ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Recipe details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecipeDetail"
                }
              }
            }
          },
          "404": {
            "description": "Recipe not found"
          }
        }
      }
    },
    "/images": {
      "post": {
        "summary": "Upload an image",
        "tags": ["Images"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Image uploaded successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Image"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Cuisine": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" }
        }
      },
      "Ingredient": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" }
        }
      },
      "Image": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "url": { "type": "string" }
        }
      },
      "Recipe": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "cuisine": { "$ref": "#/components/schemas/Cuisine" },
          "image": { "$ref": "#/components/schemas/Image" }
        }
      },
      "RecipeDetail": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "cuisine": { "$ref": "#/components/schemas/Cuisine" },
          "image": { "$ref": "#/components/schemas/Image" },
          "ingredients": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Ingredient" }
          },
          "instructions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "stepNumber": { "type": "integer" },
                "description": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
